config strategy 'Yv03_openwrt'
	option enabled '0'
	option port '443'
	list filter_l3 'ipv4'
	list protocol 'tcp'
	list filter_l7 'tls'
	list hostlist 'list_hosts_youtube'
	option script '--payload=tls_client_hello
--lua-desync=fake:blob=0x00000000:tcp_seq=-10000:tcp_ack=-66000:repeats=2:tls_mod=rnd,dupsid,sni=www.google.com
--lua-desync=multisplit:pos=1,midsld'
