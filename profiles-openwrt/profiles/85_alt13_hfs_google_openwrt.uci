config strategy '85_alt13_hfs_google_openwrt'
	option enabled '0'
	option port '80,443'
	list protocol 'tcp'
	list filter_l3 'ipv4'
	option script '--filter-l7=http,tls --hostlist=/opt/zapret2/profiles-openwrt/lists/list-general.txt --hostlist=/opt/zapret2/profiles-openwrt/lists/list-general-user.txt --hostlist-exclude=/opt/zapret2/profiles-openwrt/lists/list-exclude.txt --hostlist-exclude=/opt/zapret2/profiles-openwrt/lists/list-exclude-user.txt --ipset-exclude=/opt/zapret2/profiles-openwrt/lists/ipset-exclude.txt --ipset-exclude=/opt/zapret2/profiles-openwrt/lists/ipset-exclude-user.txt --payload=tls_client_hello,http_req --out-range=-d10 --lua-desync=hostfakesplit:host=www.google.com:tcp_ts=-600000:tcp_md5:repeats=6'
