config strategy '60_discord_main_openwrt'
	option enabled '0'
	option port '443,2053,2083,2087,2096,8443'
	list protocol 'tcp'
	list filter_l3 'ipv4'
	option script '--filter-l7=tls --hostlist-domains=discord.com,discord.gg,gateway.discord.gg,discordapp.com,discordapp.net,discordcdn.com,discord.media,discordstatus.com --payload=tls_client_hello --out-range=-d10 --lua-desync=fake:blob=openwrt_tls_def_ozon:tcp_seq=-10000:tcp_ack=-66000:repeats=8 --lua-desync=multidisorder:pos=1,sniext+1,midsld'
