config strategy '98_fs_fta_alt_fakedsplit_openwrt'
	option enabled '0'
	option port '80,443'
	list protocol 'tcp'
	list filter_l3 'ipv4'
	option script '--filter-l7=http,tls --hostlist=/opt/zapret2/profiles-openwrt/lists/list-general.txt --hostlist=/opt/zapret2/profiles-openwrt/lists/list-general-user.txt --hostlist-exclude=/opt/zapret2/profiles-openwrt/lists/list-exclude.txt --hostlist-exclude=/opt/zapret2/profiles-openwrt/lists/list-exclude-user.txt --ipset-exclude=/opt/zapret2/profiles-openwrt/lists/ipset-exclude.txt --ipset-exclude=/opt/zapret2/profiles-openwrt/lists/ipset-exclude-user.txt --payload=tls_client_hello,http_req --out-range=-d10 --lua-desync=fake:blob=openwrt_default_tls:tls_mod=rnd,dupsid,sni=www.google.com:tcp_seq=-2:tcp_ack=-66000:repeats=8:payload=tls_client_hello --lua-desync=fake:blob=openwrt_tls_sferum:tcp_seq=-2:tcp_ack=-66000:repeats=8:payload=http_req --lua-desync=fakedsplit:pos=1:tcp_seq=-2:tcp_ack=-66000:repeats=8'
