config strategy 'games_udp_openwrt'
	option enabled '1'
	option port '88,1024-2407,2409-4499,4502-19293,19345-49999,50101-65535'
	list filter_l3 'ipv4'
	list protocol 'udp'
	option script '--out-range=<n4
--payload=known,unknown
--lua-desync=fake:blob=blob_quic_initial_4pda_to:repeats=10:payload=known,unknown'
