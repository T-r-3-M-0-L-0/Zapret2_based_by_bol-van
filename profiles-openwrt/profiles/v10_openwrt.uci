config strategy 'v10_openwrt'
	option enabled '0'
	option port '443'
	list filter_l3 'ipv4'
	list protocol 'tcp'
	list filter_l7 'tls'
	option script '--payload=tls_client_hello
--lua-desync=fake:blob=blob_tls_clienthello_www_google_com:optional:tcp_ts=-600000:tls_mod=rnd,sni=maxcdn.bootstrapcdn.com
--lua-desync=multisplit:pos=2'
	list hostlist_exclude 'list_hosts_user_exclude'
	list hostlist_exclude 'list_hosts_youtube'
