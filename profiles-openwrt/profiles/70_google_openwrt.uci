config strategy '70_google_openwrt'
	option enabled '0'
	option port '443'
	list protocol 'tcp'
	list filter_l3 'ipv4'
	option script '--filter-l7=tls --hostlist=/opt/zapret2/profiles-openwrt/lists/list-google.txt --payload=tls_client_hello --out-range=-d10 --lua-desync=fake:blob=openwrt_tls_google:tcp_ts=-600000:repeats=6:ip_id=zero --lua-desync=fakedsplit:pattern=0x00:tcp_ts=-600000:ip_id=zero'
