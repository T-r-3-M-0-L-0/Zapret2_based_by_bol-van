config strategy '92_fs_alt4_fake_badseq_openwrt'
	option enabled '0'
	option port '80,443'
	list protocol 'tcp'
	list filter_l3 'ipv4'
	option script '--filter-l7=http,tls --hostlist=/opt/zapret2/profiles-openwrt/lists/list-general.txt --hostlist=/opt/zapret2/profiles-openwrt/lists/list-general-user.txt --hostlist-exclude=/opt/zapret2/profiles-openwrt/lists/list-exclude.txt --hostlist-exclude=/opt/zapret2/profiles-openwrt/lists/list-exclude-user.txt --ipset-exclude=/opt/zapret2/profiles-openwrt/lists/ipset-exclude.txt --ipset-exclude=/opt/zapret2/profiles-openwrt/lists/ipset-exclude-user.txt --payload=tls_client_hello,http_req --out-range=-d10 --lua-desync=fake:blob=openwrt_stun:tcp_seq=-1000:tcp_ack=-66000:repeats=6:payload=tls_client_hello --lua-desync=fake:blob=openwrt_tls_google:tcp_seq=-1000:tcp_ack=-66000:repeats=6:payload=tls_client_hello --lua-desync=fake:blob=openwrt_tls_sferum:tcp_seq=-1000:tcp_ack=-66000:repeats=6:payload=http_req --lua-desync=multisplit'
