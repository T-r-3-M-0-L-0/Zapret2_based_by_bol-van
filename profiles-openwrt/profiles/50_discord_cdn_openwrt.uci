config strategy '50_discord_cdn_openwrt'
	option enabled '0'
	option port '443'
	list protocol 'tcp'
	list filter_l3 'ipv4'
	option script '--filter-l7=tls --hostlist-domains=cdn.discordapp.com,stable.dl2.discordapp.net --payload=tls_client_hello --out-range=-d10 --lua-desync=fake:blob=openwrt_tls_ozon:tcp_seq=-10000:tcp_ack=-66000:repeats=8 --lua-desync=multidisorder:pos=1,midsld:seqovl=652:seqovl_pattern=openwrt_tls_ozon'
